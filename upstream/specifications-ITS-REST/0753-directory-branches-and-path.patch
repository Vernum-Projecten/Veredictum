--- a/specifications/operations/directory_delete.yaml
+++ b/specifications/operations/directory_delete.yaml
@@ -2,6 +2,7 @@ operationId: directory_delete
 summary: Delete directory
 description: |
   Deletes directory FOLDER associated with the EHR identified by `ehr_id`.
