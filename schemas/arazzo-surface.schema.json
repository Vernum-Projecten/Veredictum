{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openehr:cnf:schema:arazzo-surface:0.1.0",
  "title": "Surface coverage of the Arazzo catalogue",
  "description": "Lives at `cases/surface.yaml`. `scope` names the operation families the catalogue has converted, each an ITS-REST API document and an OAS tag. Inside that scope every released operation, every response it declares and every value of its negotiation headers is covered by a step, or is listed in `gaps` with the issue that tracks it. A gap whose element is covered is refused, so the list only shrinks.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scope"
  ],
  "properties": {
    "scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "api",
          "tag"
        ],
        "properties": {
          "api": {
            "type": "string",
            "pattern": "^[a-z]+$"
          },
          "tag": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "api",
          "operation",
          "issue"
        ],
        "oneOf": [
          {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "status"
                  ]
                },
                {
                  "required": [
                    "header"
                  ]
                },
                {
                  "required": [
                    "value"
                  ]
                }
              ]
            }
          },
          {
            "required": [
              "status"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "header"
                  ]
                },
                {
                  "required": [
                    "value"
                  ]
                }
              ]
            }
          },
          {
            "required": [
              "header",
              "value"
            ],
            "not": {
              "required": [
                "status"
              ]
            }
          }
        ],
        "properties": {
          "api": {
            "type": "string",
            "pattern": "^[a-z]+$"
          },
          "operation": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "pattern": "^[1-5][0-9][0-9]$"
          },
          "header": {
            "enum": [
              "Accept",
              "Content-Type",
              "Prefer"
            ]
          },
          "value": {
            "type": "string",
            "minLength": 1
          },
          "issue": {
            "type": "integer",
            "minimum": 1
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
