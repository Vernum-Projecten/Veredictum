{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openehr:cnf:schema:arazzo-results:0.1.0",
  "title": "Arazzo run results",
  "description": "One row per workflow row of one Arazzo document, each passed, failed, errored or skipped. A failed or errored row carries the four-part explanation (what was checked, why it is required, expected against received with the exchange, whose problem it is); a skipped row carries one reason from the closed list and its citation. Re-judging the HAR recording of the run writes the same bytes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document",
    "engine",
    "instrument_status",
    "base_url",
    "rows"
  ],
  "properties": {
    "document": {
      "type": "string",
      "minLength": 1
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "instrument_status": {
      "enum": [
        "pre-approval",
        "sec-approved"
      ],
      "description": "The approval status of the instrument that wrote this document, derived from its own version: pre-approval for every 0.x version, which the openEHR SEC has not approved, and sec-approved from 1.0.0, which marks that approval."
    },
    "base_url": {
      "type": "string"
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case",
          "row",
          "status",
          "inputs",
          "generated"
        ],
        "properties": {
          "case": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_\\-]+/[A-Za-z0-9_\\-]+$"
          },
          "row": {
            "type": "integer",
            "minimum": 0
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "errored",
              "skipped"
            ]
          },
          "inputs": {
            "type": "object"
          },
          "generated": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "skip": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reason",
              "why"
            ],
            "properties": {
              "reason": {
                "enum": [
                  "not-claimed",
                  "option-not-selected",
                  "version-out-of-range",
                  "format-not-claimed",
                  "extension-not-offered",
                  "not-declared"
                ]
              },
              "why": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "source",
                  "section",
                  "quote"
                ],
                "properties": {
                  "source": {
                    "type": "string",
                    "minLength": 1
                  },
                  "section": {
                    "type": "string"
                  },
                  "quote": {
                    "type": "string"
                  },
                  "link": {
                    "type": "string",
                    "minLength": 1
                  },
                  "report": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          },
          "explanation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "step",
              "what",
              "expected",
              "received",
              "whose"
            ],
            "properties": {
              "step": {
                "type": "string",
                "minLength": 1
              },
              "what": {
                "type": "string"
              },
              "why": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "source",
                  "section",
                  "quote"
                ],
                "properties": {
                  "source": {
                    "type": "string",
                    "minLength": 1
                  },
                  "section": {
                    "type": "string"
                  },
                  "quote": {
                    "type": "string"
                  },
                  "link": {
                    "type": "string",
                    "minLength": 1
                  },
                  "report": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              },
              "expected": {
                "type": "string"
              },
              "received": {
                "type": "string"
              },
              "exchange": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "entry",
                  "method",
                  "url",
                  "status"
                ],
                "properties": {
                  "entry": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "method": {
                    "type": "string"
                  },
                  "url": {
                    "type": "string"
                  },
                  "status": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              "whose": {
                "enum": [
                  "server",
                  "instrument",
                  "advisory"
                ]
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "skipped"
                }
              }
            },
            "then": {
              "required": [
                "skip"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "failed",
                    "errored"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "explanation"
              ]
            }
          }
        ]
      }
    }
  }
}
