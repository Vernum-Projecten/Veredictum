{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openehr:cnf:schema:arazzo-results:0.1.0",
  "title": "Arazzo run results",
  "description": "One row per workflow row of one Arazzo document, or of every document of a catalogue run, each passed, failed, errored or skipped. A failed or errored row carries the four-part explanation (what was checked, why it is required, expected against received with the exchange, whose problem it is); a skipped row carries one reason from the closed list and its citation. Re-judging the HAR recording of the run writes the same bytes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document",
    "engine",
    "instrument_status",
    "base_url",
    "rows"
  ],
  "properties": {
    "document": {
      "type": "string",
      "minLength": 1,
      "description": "The document's name, the prefix of every case id; `catalogue` for a catalogue run, whose case ids each carry their own document's name."
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "instrument_status": {
      "enum": [
        "pre-approval",
        "sec-approved"
      ],
      "description": "The approval status of the instrument that wrote this document, derived from its own version: pre-approval for every 0.x version, which the openEHR SEC has not approved, and sec-approved from 1.0.0, which marks that approval."
    },
    "specification": {
      "type": "object",
      "required": [
        "profile"
      ],
      "description": "The specification text the run's citations were read against. `released` is the vendored release, the oracle of every released claim. `development` is the pinned `master` of each openEHR specification repository, the line that carries the newest text, named component by component with its repository, branch and commit; a development result builds no certificate and is never compared with or counted toward a released result. A results document without this member was judged against the release. No openEHR spec governs the profiles; they are the instrument's own design.",
      "properties": {
        "profile": {
          "enum": [
            "released",
            "development"
          ]
        },
        "snapshot": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "component",
              "repository",
              "branch",
              "commit"
            ],
            "properties": {
              "component": {
                "type": "string",
                "minLength": 1
              },
              "repository": {
                "type": "string",
                "minLength": 1
              },
              "branch": {
                "type": "string",
                "minLength": 1
              },
              "commit": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              }
            }
          }
        }
      },
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "profile": {
              "const": "released"
            }
          }
        },
        {
          "additionalProperties": false,
          "required": [
            "snapshot"
          ],
          "properties": {
            "profile": {
              "const": "development"
            },
            "snapshot": true
          }
        }
      ]
    },
    "base_url": {
      "type": "string"
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case",
          "row",
          "status",
          "inputs",
          "generated"
        ],
        "properties": {
          "case": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_\\-]+/[A-Za-z0-9_\\-]+$"
          },
          "row": {
            "type": "integer",
            "minimum": 0
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "errored",
              "skipped"
            ]
          },
          "inputs": {
            "type": "object"
          },
          "generated": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "skip": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reason",
              "why"
            ],
            "properties": {
              "reason": {
                "enum": [
                  "not-claimed",
                  "option-not-selected",
                  "version-out-of-range",
                  "format-not-claimed",
                  "extension-not-offered",
                  "not-declared",
                  "cited-text-absent",
                  "development-only",
                  "contested-in-development"
                ]
              },
              "why": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "source",
                  "section",
                  "quote"
                ],
                "properties": {
                  "source": {
                    "type": "string",
                    "minLength": 1
                  },
                  "section": {
                    "type": "string"
                  },
                  "quote": {
                    "type": "string"
                  },
                  "link": {
                    "type": "string",
                    "minLength": 1
                  },
                  "report": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              },
              "detail": {
                "type": "string",
                "minLength": 1,
                "description": "What the reason leaves to say: for `cited-text-absent`, the specification profile and what of the cited text it lacks (the file, the section or the quote); for `development-only`, the development citation the case rests on; for `contested-in-development`, the upstream report that records the contradiction and the contested citation; for `extension-not-offered`, the setup that calls the extension and the extension it calls."
              }
            }
          },
          "explanation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "step",
              "what",
              "expected",
              "received",
              "whose"
            ],
            "properties": {
              "step": {
                "type": "string",
                "minLength": 1
              },
              "what": {
                "type": "string"
              },
              "why": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "source",
                  "section",
                  "quote"
                ],
                "properties": {
                  "source": {
                    "type": "string",
                    "minLength": 1
                  },
                  "section": {
                    "type": "string"
                  },
                  "quote": {
                    "type": "string"
                  },
                  "link": {
                    "type": "string",
                    "minLength": 1
                  },
                  "report": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              },
              "expected": {
                "type": "string"
              },
              "received": {
                "type": "string"
              },
              "exchange": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "entry",
                  "method",
                  "url",
                  "status"
                ],
                "properties": {
                  "entry": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "method": {
                    "type": "string"
                  },
                  "url": {
                    "type": "string"
                  },
                  "status": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              "whose": {
                "enum": [
                  "server",
                  "instrument",
                  "warning"
                ]
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "skipped"
                }
              }
            },
            "then": {
              "required": [
                "skip"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "failed",
                    "errored"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "explanation"
              ]
            }
          }
        ]
      }
    },
    "server": {
      "type": "object",
      "description": "What the server stated about itself through the ITS-REST System OPTIONS operation (specifications/operations/options.yaml, which says services SHOULD answer), on a catalogue run. `exchange` is the run's own System OPTIONS exchange at recording entry `entry`; `read` is the read the instrument made after the catalogue ran because the run exchanged none, kept in the recording's log; `unanswered` is that read failing at the transport; `not_recorded` is a re-judged recording carrying no answer. The server's `restapi_specs_version` is `answer.options.restapi_specs_version`, present only when the server stated it. Nothing here counts toward conformance.",
      "required": [
        "read"
      ],
      "oneOf": [
        {
          "additionalProperties": false,
          "required": [
            "read",
            "entry",
            "answer"
          ],
          "properties": {
            "read": {
              "const": "exchange"
            },
            "entry": {
              "type": "integer",
              "minimum": 0
            },
            "answer": {
              "type": "object",
              "required": [
                "outcome",
                "status"
              ],
              "oneOf": [
                {
                  "additionalProperties": false,
                  "required": [
                    "outcome",
                    "status",
                    "options"
                  ],
                  "properties": {
                    "outcome": {
                      "const": "offered"
                    },
                    "status": {
                      "const": 200
                    },
                    "options": {
                      "type": "object",
                      "additionalProperties": false,
                      "description": "The members of the `Options` document the server sent; a member the schema does not name is not carried.",
                      "properties": {
                        "solution": {
                          "type": "string",
                          "description": "The product name."
                        },
                        "solution_version": {
                          "type": "string",
                          "description": "The product version."
                        },
                        "vendor": {
                          "type": "string",
                          "description": "The vendor."
                        },
                        "restapi_specs_version": {
                          "type": "string",
                          "description": "The ITS-REST release the server states it implements."
                        },
                        "conformance_profile": {
                          "type": "string",
                          "description": "The conformance profile the server states."
                        },
                        "endpoints": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          },
                          "description": "The endpoints the server lists."
                        }
                      }
                    }
                  }
                },
                {
                  "additionalProperties": false,
                  "required": [
                    "outcome",
                    "status"
                  ],
                  "properties": {
                    "outcome": {
                      "const": "not_offered"
                    },
                    "status": {
                      "type": "integer",
                      "minimum": 100,
                      "maximum": 599,
                      "not": {
                        "minimum": 200,
                        "maximum": 299
                      }
                    }
                  }
                },
                {
                  "additionalProperties": false,
                  "required": [
                    "outcome",
                    "status",
                    "reason"
                  ],
                  "properties": {
                    "outcome": {
                      "const": "not_options_document"
                    },
                    "status": {
                      "type": "integer",
                      "minimum": 200,
                      "maximum": 299
                    },
                    "reason": {
                      "type": "string",
                      "description": "Why the body is not an `Options` document, in the parser's own words."
                    }
                  }
                },
                {
                  "additionalProperties": false,
                  "required": [
                    "outcome",
                    "status"
                  ],
                  "properties": {
                    "outcome": {
                      "const": "invalid_status"
                    },
                    "status": {
                      "type": "integer",
                      "minimum": 600,
                      "maximum": 999,
                      "description": "A three-digit code outside 100..599, which RFC 9110 §15 makes invalid."
                    }
                  }
                }
              ]
            }
          }
        },
        {
          "additionalProperties": false,
          "required": [
            "read",
            "answer"
          ],
          "properties": {
            "read": {
              "const": "read"
            },
            "answer": {
              "type": "object",
              "required": [
                "outcome",
                "status"
              ],
              "oneOf": [
                {
                  "additionalProperties": false,
                  "required": [
                    "outcome",
                    "status",
                    "options"
                  ],
                  "properties": {
                    "outcome": {
                      "const": "offered"
                    },
                    "status": {
                      "const": 200
                    },
                    "options": {
                      "type": "object",
                      "additionalProperties": false,
                      "description": "The members of the `Options` document the server sent; a member the schema does not name is not carried.",
                      "properties": {
                        "solution": {
                          "type": "string",
                          "description": "The product name."
                        },
                        "solution_version": {
                          "type": "string",
                          "description": "The product version."
                        },
                        "vendor": {
                          "type": "string",
                          "description": "The vendor."
                        },
                        "restapi_specs_version": {
                          "type": "string",
                          "description": "The ITS-REST release the server states it implements."
                        },
                        "conformance_profile": {
                          "type": "string",
                          "description": "The conformance profile the server states."
                        },
                        "endpoints": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          },
                          "description": "The endpoints the server lists."
                        }
                      }
                    }
                  }
                },
                {
                  "additionalProperties": false,
                  "required": [
                    "outcome",
                    "status"
                  ],
                  "properties": {
                    "outcome": {
                      "const": "not_offered"
                    },
                    "status": {
                      "type": "integer",
                      "minimum": 100,
                      "maximum": 599,
                      "not": {
                        "minimum": 200,
                        "maximum": 299
                      }
                    }
                  }
                },
                {
                  "additionalProperties": false,
                  "required": [
                    "outcome",
                    "status",
                    "reason"
                  ],
                  "properties": {
                    "outcome": {
                      "const": "not_options_document"
                    },
                    "status": {
                      "type": "integer",
                      "minimum": 200,
                      "maximum": 299
                    },
                    "reason": {
                      "type": "string",
                      "description": "Why the body is not an `Options` document, in the parser's own words."
                    }
                  }
                },
                {
                  "additionalProperties": false,
                  "required": [
                    "outcome",
                    "status"
                  ],
                  "properties": {
                    "outcome": {
                      "const": "invalid_status"
                    },
                    "status": {
                      "type": "integer",
                      "minimum": 600,
                      "maximum": 999,
                      "description": "A three-digit code outside 100..599, which RFC 9110 §15 makes invalid."
                    }
                  }
                }
              ]
            }
          }
        },
        {
          "additionalProperties": false,
          "required": [
            "read",
            "error"
          ],
          "properties": {
            "read": {
              "const": "unanswered"
            },
            "error": {
              "type": "string",
              "description": "The transport's own failure."
            }
          }
        },
        {
          "additionalProperties": false,
          "required": [
            "read"
          ],
          "properties": {
            "read": {
              "const": "not_recorded"
            }
          }
        }
      ]
    },
    "outline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chapters",
        "options",
        "cases"
      ],
      "description": "The reading structure the catalogue declares, so every view groups the rows without reading the catalogue: the chapters with their capability folders and each folder's BASE sections in reading order, every option with its theme, its tier and the arms the statement selected, the upstream reports the catalogue cites, and where each case sits. A case is BASE when no option arm names its document, and OPTION otherwise. No openEHR spec governs the structure; it is the instrument's own design.",
      "properties": {
        "chapters": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "chapter",
              "title",
              "folders"
            ],
            "properties": {
              "chapter": {
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "folders": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "folder",
                    "title",
                    "sections"
                  ],
                  "properties": {
                    "folder": {
                      "type": "string",
                      "minLength": 1
                    },
                    "title": {
                      "type": "string",
                      "minLength": 1
                    },
                    "formalism": {
                      "type": "boolean"
                    },
                    "sections": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "section",
                          "title"
                        ],
                        "properties": {
                          "section": {
                            "type": "string",
                            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                          },
                          "title": {
                            "type": "string",
                            "minLength": 1
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "option",
              "description",
              "theme",
              "tier",
              "folders",
              "arms"
            ],
            "properties": {
              "option": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "theme": {
                "enum": [
                  "canonical-xml",
                  "simplified-formats",
                  "left-open"
                ]
              },
              "tier": {
                "enum": [
                  "recommended",
                  "options",
                  "spec-boundary"
                ],
                "description": "`recommended`: support is a SHOULD. `options`: a MAY, or behaviour the release leaves to the implementation. `spec-boundary`: an option only because the released text is defective, recorded in the upstream report `report` names."
              },
              "report": {
                "type": "integer",
                "minimum": 1
              },
              "folders": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "arms": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "arm",
                    "selected",
                    "documents"
                  ],
                  "properties": {
                    "arm": {
                      "type": "string",
                      "minLength": 1
                    },
                    "selected": {
                      "type": "boolean"
                    },
                    "documents": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "reports": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "report",
              "title",
              "state"
            ],
            "properties": {
              "report": {
                "type": "integer",
                "minimum": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "state": {
                "enum": [
                  "open",
                  "confirmed",
                  "closed"
                ]
              }
            }
          }
        },
        "cases": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z0-9_\\-]+/[A-Za-z0-9_\\-]+$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "chapter",
              "folder",
              "standing"
            ],
            "properties": {
              "chapter": {
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
              },
              "folder": {
                "type": "string",
                "minLength": 1
              },
              "standing": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "kind",
                      "section"
                    ],
                    "properties": {
                      "kind": {
                        "const": "base"
                      },
                      "section": {
                        "type": "string",
                        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "kind",
                      "arms"
                    ],
                    "properties": {
                      "kind": {
                        "const": "option"
                      },
                      "arms": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "option",
                            "arm"
                          ],
                          "properties": {
                            "option": {
                              "type": "string",
                              "minLength": 1
                            },
                            "arm": {
                              "type": "string",
                              "minLength": 1
                            }
                          }
                        }
                      }
                    }
                  }
                ]
              },
              "trial": {
                "const": true,
                "description": "Present when a citation of the case rests on a document the vendored release marks TRIAL; every view reads such a case with the options."
              },
              "reports": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "integer",
                  "minimum": 1
                },
                "description": "The upstream reports the case's citations, or the option arm it runs on, name."
              },
              "formalism": {
                "enum": [
                  "adl1.4",
                  "adl2"
                ],
                "description": "The template formalism the case's setups upload, on a folder that badges it."
              }
            }
          }
        }
      }
    },
    "review": {
      "type": "array",
      "minItems": 1,
      "description": "The run's static review: the statement against what the server stated. No openEHR spec governs the comparison; it is the instrument's own design. A note changes no row's status and no exit status.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "declared",
          "stated"
        ],
        "properties": {
          "kind": {
            "enum": [
              "restapi-version-differs"
            ],
            "description": "`restapi-version-differs`: the statement's `spec_versions.its_rest` differs, as text, from the `restapi_specs_version` the server stated."
          },
          "declared": {
            "type": "string",
            "minLength": 1,
            "description": "The value the statement declares."
          },
          "stated": {
            "type": "string",
            "minLength": 1,
            "description": "The value the server stated."
          }
        }
      }
    }
  }
}
