{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openehr:cnf:schema:arazzo-results:0.1.0",
  "title": "Arazzo run results",
  "description": "One row per workflow row of one Arazzo document, or of every document of a catalogue run, each passed, failed, errored or skipped. A failed or errored row carries the four-part explanation (what was checked, why it is required, expected against received with the exchange, whose problem it is); a skipped row carries one reason from the closed list and its citation. Re-judging the HAR recording of the run writes the same bytes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document",
    "engine",
    "instrument_status",
    "base_url",
    "rows"
  ],
  "properties": {
    "document": {
      "type": "string",
      "minLength": 1,
      "description": "The document's name, the prefix of every case id; `catalogue` for a catalogue run, whose case ids each carry their own document's name."
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "instrument_status": {
      "enum": [
        "pre-approval",
        "sec-approved"
      ],
      "description": "The approval status of the instrument that wrote this document, derived from its own version: pre-approval for every 0.x version, which the openEHR SEC has not approved, and sec-approved from 1.0.0, which marks that approval."
    },
    "base_url": {
      "type": "string"
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case",
          "row",
          "status",
          "inputs",
          "generated"
        ],
        "properties": {
          "case": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_\\-]+/[A-Za-z0-9_\\-]+$"
          },
          "row": {
            "type": "integer",
            "minimum": 0
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "errored",
              "skipped"
            ]
          },
          "inputs": {
            "type": "object"
          },
          "generated": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "skip": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reason",
              "why"
            ],
            "properties": {
              "reason": {
                "enum": [
                  "not-claimed",
                  "option-not-selected",
                  "version-out-of-range",
                  "format-not-claimed",
                  "extension-not-offered",
                  "not-declared"
                ]
              },
              "why": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "source",
                  "section",
                  "quote"
                ],
                "properties": {
                  "source": {
                    "type": "string",
                    "minLength": 1
                  },
                  "section": {
                    "type": "string"
                  },
                  "quote": {
                    "type": "string"
                  },
                  "link": {
                    "type": "string",
                    "minLength": 1
                  },
                  "report": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          },
          "explanation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "step",
              "what",
              "expected",
              "received",
              "whose"
            ],
            "properties": {
              "step": {
                "type": "string",
                "minLength": 1
              },
              "what": {
                "type": "string"
              },
              "why": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "source",
                  "section",
                  "quote"
                ],
                "properties": {
                  "source": {
                    "type": "string",
                    "minLength": 1
                  },
                  "section": {
                    "type": "string"
                  },
                  "quote": {
                    "type": "string"
                  },
                  "link": {
                    "type": "string",
                    "minLength": 1
                  },
                  "report": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              },
              "expected": {
                "type": "string"
              },
              "received": {
                "type": "string"
              },
              "exchange": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "entry",
                  "method",
                  "url",
                  "status"
                ],
                "properties": {
                  "entry": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "method": {
                    "type": "string"
                  },
                  "url": {
                    "type": "string"
                  },
                  "status": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              "whose": {
                "enum": [
                  "server",
                  "instrument",
                  "advisory"
                ]
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "skipped"
                }
              }
            },
            "then": {
              "required": [
                "skip"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "failed",
                    "errored"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "explanation"
              ]
            }
          }
        ]
      }
    },
    "server": {
      "type": "object",
      "description": "What the server stated about itself through the ITS-REST System OPTIONS operation (specifications/operations/options.yaml, which says services SHOULD answer), on a catalogue run. `exchange` is the run's own System OPTIONS exchange at recording entry `entry`; `read` is the read the instrument made after the catalogue ran because the run exchanged none, kept in the recording's log; `unanswered` is that read failing at the transport; `not_recorded` is a re-judged recording carrying no answer. The server's `restapi_specs_version` is `answer.options.restapi_specs_version`, present only when the server stated it. Nothing here counts toward conformance.",
      "required": [
        "read"
      ],
      "oneOf": [
        {
          "additionalProperties": false,
          "required": [
            "read",
            "entry",
            "answer"
          ],
          "properties": {
            "read": {
              "const": "exchange"
            },
            "entry": {
              "type": "integer",
              "minimum": 0
            },
            "answer": {
              "type": "object",
              "required": [
                "outcome",
                "status"
              ],
              "oneOf": [
                {
                  "additionalProperties": false,
                  "required": [
                    "outcome",
                    "status",
                    "options"
                  ],
                  "properties": {
                    "outcome": {
                      "const": "offered"
                    },
                    "status": {
                      "const": 200
                    },
                    "options": {
                      "type": "object",
                      "additionalProperties": false,
                      "description": "The members of the `Options` document the server sent; a member the schema does not name is not carried.",
                      "properties": {
                        "solution": {
                          "type": "string",
                          "description": "The product name."
                        },
                        "solution_version": {
                          "type": "string",
                          "description": "The product version."
                        },
                        "vendor": {
                          "type": "string",
                          "description": "The vendor."
                        },
                        "restapi_specs_version": {
                          "type": "string",
                          "description": "The ITS-REST release the server states it implements."
                        },
                        "conformance_profile": {
                          "type": "string",
                          "description": "The conformance profile the server states."
                        },
                        "endpoints": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          },
                          "description": "The endpoints the server lists."
                        }
                      }
                    }
                  }
                },
                {
                  "additionalProperties": false,
                  "required": [
                    "outcome",
                    "status"
                  ],
                  "properties": {
                    "outcome": {
                      "const": "not_offered"
                    },
                    "status": {
                      "type": "integer",
                      "minimum": 100,
                      "maximum": 599,
                      "not": {
                        "minimum": 200,
                        "maximum": 299
                      }
                    }
                  }
                },
                {
                  "additionalProperties": false,
                  "required": [
                    "outcome",
                    "status",
                    "reason"
                  ],
                  "properties": {
                    "outcome": {
                      "const": "not_options_document"
                    },
                    "status": {
                      "type": "integer",
                      "minimum": 200,
                      "maximum": 299
                    },
                    "reason": {
                      "type": "string",
                      "description": "Why the body is not an `Options` document, in the parser's own words."
                    }
                  }
                },
                {
                  "additionalProperties": false,
                  "required": [
                    "outcome",
                    "status"
                  ],
                  "properties": {
                    "outcome": {
                      "const": "invalid_status"
                    },
                    "status": {
                      "type": "integer",
                      "minimum": 600,
                      "maximum": 999,
                      "description": "A three-digit code outside 100..599, which RFC 9110 §15 makes invalid."
                    }
                  }
                }
              ]
            }
          }
        },
        {
          "additionalProperties": false,
          "required": [
            "read",
            "answer"
          ],
          "properties": {
            "read": {
              "const": "read"
            },
            "answer": {
              "type": "object",
              "required": [
                "outcome",
                "status"
              ],
              "oneOf": [
                {
                  "additionalProperties": false,
                  "required": [
                    "outcome",
                    "status",
                    "options"
                  ],
                  "properties": {
                    "outcome": {
                      "const": "offered"
                    },
                    "status": {
                      "const": 200
                    },
                    "options": {
                      "type": "object",
                      "additionalProperties": false,
                      "description": "The members of the `Options` document the server sent; a member the schema does not name is not carried.",
                      "properties": {
                        "solution": {
                          "type": "string",
                          "description": "The product name."
                        },
                        "solution_version": {
                          "type": "string",
                          "description": "The product version."
                        },
                        "vendor": {
                          "type": "string",
                          "description": "The vendor."
                        },
                        "restapi_specs_version": {
                          "type": "string",
                          "description": "The ITS-REST release the server states it implements."
                        },
                        "conformance_profile": {
                          "type": "string",
                          "description": "The conformance profile the server states."
                        },
                        "endpoints": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          },
                          "description": "The endpoints the server lists."
                        }
                      }
                    }
                  }
                },
                {
                  "additionalProperties": false,
                  "required": [
                    "outcome",
                    "status"
                  ],
                  "properties": {
                    "outcome": {
                      "const": "not_offered"
                    },
                    "status": {
                      "type": "integer",
                      "minimum": 100,
                      "maximum": 599,
                      "not": {
                        "minimum": 200,
                        "maximum": 299
                      }
                    }
                  }
                },
                {
                  "additionalProperties": false,
                  "required": [
                    "outcome",
                    "status",
                    "reason"
                  ],
                  "properties": {
                    "outcome": {
                      "const": "not_options_document"
                    },
                    "status": {
                      "type": "integer",
                      "minimum": 200,
                      "maximum": 299
                    },
                    "reason": {
                      "type": "string",
                      "description": "Why the body is not an `Options` document, in the parser's own words."
                    }
                  }
                },
                {
                  "additionalProperties": false,
                  "required": [
                    "outcome",
                    "status"
                  ],
                  "properties": {
                    "outcome": {
                      "const": "invalid_status"
                    },
                    "status": {
                      "type": "integer",
                      "minimum": 600,
                      "maximum": 999,
                      "description": "A three-digit code outside 100..599, which RFC 9110 §15 makes invalid."
                    }
                  }
                }
              ]
            }
          }
        },
        {
          "additionalProperties": false,
          "required": [
            "read",
            "error"
          ],
          "properties": {
            "read": {
              "const": "unanswered"
            },
            "error": {
              "type": "string",
              "description": "The transport's own failure."
            }
          }
        },
        {
          "additionalProperties": false,
          "required": [
            "read"
          ],
          "properties": {
            "read": {
              "const": "not_recorded"
            }
          }
        }
      ]
    },
    "review": {
      "type": "array",
      "minItems": 1,
      "description": "The run's static review: the statement against what the server stated. No openEHR spec governs the comparison; it is the instrument's own design. A note changes no row's status and no exit status.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "declared",
          "stated"
        ],
        "properties": {
          "kind": {
            "enum": [
              "restapi-version-differs"
            ],
            "description": "`restapi-version-differs`: the statement's `spec_versions.its_rest` differs, as text, from the `restapi_specs_version` the server stated."
          },
          "declared": {
            "type": "string",
            "minLength": 1,
            "description": "The value the statement declares."
          },
          "stated": {
            "type": "string",
            "minLength": 1,
            "description": "The value the server stated."
          }
        }
      }
    }
  }
}
