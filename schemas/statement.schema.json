{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openehr:cnf:schema:statement:0.1.0",
  "title": "CNF 2.0 party statement (ICS + SDoC)",
  "description": "The supplier's Implementation Conformance Statement (the verdict-bearing claims) plus the SDoC self-declaration. The canonical JSON interchange artifact the verdict machinery consumes; verdicts are computed from it, never asserted here.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "product",
    "schedule_release",
    "claims"
  ],
  "properties": {
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "vendor",
        "identifier"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "vendor": {
          "type": "string",
          "minLength": 1
        },
        "identifier": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "schedule_release": {
      "type": "string",
      "minLength": 1
    },
    "spec_versions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rm": {
          "type": "string"
        },
        "base": {
          "type": "string"
        },
        "am": {
          "type": "string"
        },
        "aql": {
          "type": "string"
        },
        "its_rest": {
          "type": "string"
        },
        "term": {
          "type": "string"
        }
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capabilities"
      ],
      "properties": {
        "capabilities": {
          "description": "The capabilities the party claims, at least one: each is a capability folder under `catalogue/cases/`, whose name is the folder's. Every workflow of an Arazzo document in a capability folder the statement does not claim is skipped not-claimed.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          }
        }
      }
    },
    "tech_profiles": {
      "description": "The technology profiles the party claims, each an ITS with the wire formats the party serves on it. A statement without an its-rest profile claims every format. Every workflow of an Arazzo document that needs a wire format the statement's its-rest profile does not list is skipped format-not-claimed.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "its"
        ],
        "properties": {
          "its": {
            "enum": [
              "its-rest"
            ]
          },
          "formats": {
            "type": "array",
            "items": {
              "enum": [
                "canonical-json",
                "canonical-xml",
                "wt-flat",
                "wt-structured",
                "wt"
              ]
            }
          }
        }
      }
    },
    "options": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_-]+$"
      }
    },
    "non_functional": {
      "type": "object"
    },
    "extensions": {
      "description": "The extension routes the party offers, each keyed by an extension the catalogue defines: the party's own OpenAPI document, a path relative to the statement, and the operationId in it that realises the extension. An extension route only prepares ground for a case in a shared setup, and no verdict ever judges its response. Every case whose setups call an extension the statement does not declare here is skipped extension-not-offered.",
      "type": "object",
      "propertyNames": {
        "enum": [
          "ehr-import"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "document",
          "operation_id"
        ],
        "properties": {
          "document": {
            "description": "The party's own OpenAPI document that declares the route, a path relative to the statement.",
            "type": "string",
            "minLength": 1
          },
          "operation_id": {
            "description": "The operationId in that document that realises the extension.",
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "results_path",
          "sha256"
        ],
        "properties": {
          "results_path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signatory",
        "role",
        "date",
        "statement"
      ],
      "properties": {
        "signatory": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
